# Dockerfile for building Hermeneia with CUDA 12.8
# Two stages: base (toolchain + CUDA libs) → bundler (+ Node.js for Tauri bundles)
# Only requires NVIDIA driver on host, NOT full CUDA toolkit

# ============================================================================
# Base stage: CUDA toolkit + Rust + system deps + CUDA runtime libs
# Used by: build-dev (mounts source), bundler (adds Node.js)
# ============================================================================
FROM nvidia/cuda:12.8.0-devel-ubuntu22.04 AS base

# Install build dependencies
RUN apt-get update && apt-get install -y \
    curl \
    git \
    build-essential \
    pkg-config \
    libssl-dev \
    libwebkit2gtk-4.1-dev \
    libgtk-3-dev \
    libayatana-appindicator3-dev \
    librsvg2-dev \
    libasound2-dev \
    patchelf \
    # Required for sherpa-onnx CUDA build (no download-binaries):
    # clang/libclang-dev → bindgen FFI binding generation
    # cmake + ninja-build → sherpa-onnx CMake build system
    clang \
    libclang-dev \
    cmake \
    ninja-build \
    # cuDNN 9 for ORT CUDA provider (RNN/LSTM ops)
    libcudnn9-cuda-12 \
    && rm -rf /var/lib/apt/lists/*

# Explicitly tell bindgen where libclang lives.
# Ubuntu 22.04 ships LLVM 14; libclang-dev installs the .so there.
ENV LIBCLANG_PATH=/usr/lib/llvm-14/lib

# PTX JIT: compile for sm_75 baseline, driver JIT-compiles to actual GPU (RTX 5090 = sm_120)
ENV CUDA_COMPUTE_CAP=75

# Install Rust
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:$PATH"

# Set up CUDA paths
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=${CUDA_HOME}/bin:${PATH}
ENV LD_LIBRARY_PATH=${CUDA_HOME}/lib64:${LD_LIBRARY_PATH}


# Download pre-built sherpa-onnx with CUDA 12.x + cuDNN 9.x ORT (built by k2-fsa).
# Setting SHERPA_LIB_PATH tells sherpa-rs-sys to skip cmake and use these libs directly,
# bypassing the cmake-hardcoded ORT 1.17.1-patched which only supports CUDA 11.
ARG SHERPA_ONNX_VERSION=1.12.28
ARG SHERPA_ONNX_SHA256=9e816c408fced966dc1f2127050769dfb4a35f45f55e1099a051906e3f0c90d3
RUN curl -fsSL -o /tmp/sherpa-onnx-cuda12.tar.bz2 \
    "https://github.com/k2-fsa/sherpa-onnx/releases/download/v${SHERPA_ONNX_VERSION}/sherpa-onnx-v${SHERPA_ONNX_VERSION}-cuda-12.x-cudnn-9.x-linux-x64-gpu.tar.bz2" && \
    echo "${SHERPA_ONNX_SHA256}  /tmp/sherpa-onnx-cuda12.tar.bz2" | sha256sum -c - && \
    mkdir -p /opt/sherpa-onnx-cuda12 && \
    tar -xjf /tmp/sherpa-onnx-cuda12.tar.bz2 -C /opt/sherpa-onnx-cuda12 && \
    rm /tmp/sherpa-onnx-cuda12.tar.bz2
ENV SHERPA_LIB_PATH=/opt/sherpa-onnx-cuda12/sherpa-onnx-v${SHERPA_ONNX_VERSION}-cuda-12.x-cudnn-9.x-linux-x64-gpu

WORKDIR /build

# Prepare bundled CUDA libraries BEFORE building
# This ensures the binary links against the exact libraries we'll bundle
RUN mkdir -p /build/lib && \
    echo "=== Copying CUDA runtime libraries ===" && \
    cp -P ${CUDA_HOME}/lib64/libcudart.so* /build/lib/ && \
    cp -P ${CUDA_HOME}/lib64/libcublas.so* /build/lib/ && \
    cp -P ${CUDA_HOME}/lib64/libcublasLt.so* /build/lib/ && \
    cp -P ${CUDA_HOME}/lib64/libnvrtc.so* /build/lib/ && \
    cp -P ${CUDA_HOME}/lib64/libcufft.so* /build/lib/ 2>/dev/null || true && \
    cp -P ${CUDA_HOME}/lib64/libcurand.so* /build/lib/ 2>/dev/null || true && \
    echo "=== Copying cuDNN 9 libraries ===" && \
    cp -P /usr/lib/x86_64-linux-gnu/libcudnn*.so* /build/lib/ 2>/dev/null || true && \
    echo "" && \
    echo "=== Bundled libraries ===" && \
    ls -lh /build/lib/

# Add our lib directory to the library path during build
ENV LD_LIBRARY_PATH=/build/lib:${LD_LIBRARY_PATH}

# ============================================================================
# Bundler stage: base + Node.js for tauri build (.deb/.rpm/.AppImage)
# Used by: bundle-cuda service
# ============================================================================
FROM base AS bundler

RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y \
    nodejs \
    # RPM bundling
    rpm \
    # AppImage bundling
    libfuse2 \
    file \
    xdg-utils \
    squashfs-tools \
    desktop-file-utils \
    && rm -rf /var/lib/apt/lists/*

# appimagetool for post-processing AppImages (remove bundled libcuda stub)
RUN curl -fsSL -o /usr/local/bin/appimagetool \
    "https://github.com/AppImage/AppImageKit/releases/download/continuous/appimagetool-x86_64.AppImage" && \
    chmod +x /usr/local/bin/appimagetool
