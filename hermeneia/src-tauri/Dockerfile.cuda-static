# Dockerfile for building Hermeneia with bundled CUDA 12.8 libraries
# Output: binary + lib/ folder with CUDA .so files
# Only requires NVIDIA driver on host, NOT full CUDA toolkit

FROM nvidia/cuda:12.8.0-devel-ubuntu22.04 AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    curl \
    git \
    build-essential \
    pkg-config \
    libssl-dev \
    libwebkit2gtk-4.1-dev \
    libgtk-3-dev \
    libayatana-appindicator3-dev \
    librsvg2-dev \
    libasound2-dev \
    patchelf \
    && rm -rf /var/lib/apt/lists/*

# Install Rust
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:$PATH"

# Set up CUDA paths
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=${CUDA_HOME}/bin:${PATH}
ENV LD_LIBRARY_PATH=${CUDA_HOME}/lib64:${LD_LIBRARY_PATH}

# Configure for RTX 5090 (Blackwell = sm_120 = compute capability 12.0)
# Note: bindgen_cuda only supports a single compute cap value
ENV CUDA_COMPUTE_CAP=120

WORKDIR /build

# Prepare bundled CUDA libraries BEFORE building
# This ensures the binary links against the exact libraries we'll bundle
RUN mkdir -p /build/lib && \
    echo "=== Copying CUDA runtime libraries ===" && \
    cp -P ${CUDA_HOME}/lib64/libcudart.so* /build/lib/ && \
    cp -P ${CUDA_HOME}/lib64/libcublas.so* /build/lib/ && \
    cp -P ${CUDA_HOME}/lib64/libcublasLt.so* /build/lib/ && \
    cp -P ${CUDA_HOME}/lib64/libnvrtc.so* /build/lib/ && \
    cp -P ${CUDA_HOME}/lib64/libcufft.so* /build/lib/ 2>/dev/null || true && \
    cp -P ${CUDA_HOME}/lib64/libcurand.so* /build/lib/ 2>/dev/null || true && \
    echo "" && \
    echo "=== Bundled libraries ===" && \
    ls -lh /build/lib/

# Copy project files
COPY Cargo.toml Cargo.lock ./
COPY src ./src
COPY build.rs ./
COPY tauri.conf.json ./
COPY assets ./assets
COPY icons ./icons

# Build with CUDA feature, using our bundled libraries
# Add our lib directory to the library path during build
ENV LD_LIBRARY_PATH=/build/lib:${LD_LIBRARY_PATH}
RUN cargo build --release --features cuda --bin transcribe

# Create distribution package with RPATH set
RUN mkdir -p /dist/lib && \
    cp /build/target/release/transcribe /dist/ && \
    cp /build/lib/* /dist/lib/ && \
    # Set RPATH so binary looks for libraries in ./lib relative to binary location
    patchelf --set-rpath '$ORIGIN/lib' /dist/transcribe && \
    echo "" && \
    echo "=== Verifying RPATH ===" && \
    patchelf --print-rpath /dist/transcribe && \
    echo "" && \
    echo "=== All binary dependencies ===" && \
    LD_LIBRARY_PATH=/dist/lib ldd /dist/transcribe && \
    echo "" && \
    echo "=== CUDA/NVIDIA dependencies ===" && \
    (LD_LIBRARY_PATH=/dist/lib ldd /dist/transcribe | grep -E "cuda|nvidia" || echo "No direct CUDA deps - may use driver API only") && \
    echo "" && \
    echo "=== Distribution package ===" && \
    ls -lh /dist/ && \
    echo "" && \
    ls -lh /dist/lib/

# Runtime stage - minimal image for testing
FROM ubuntu:22.04 AS runtime

# Only install NVIDIA driver stubs for testing
# Real host will have actual drivers
RUN apt-get update && apt-get install -y \
    libnvidia-compute-545 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/target/release/transcribe /usr/local/bin/transcribe

ENTRYPOINT ["transcribe"]
