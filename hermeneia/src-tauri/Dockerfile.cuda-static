# Dockerfile for building Hermeneia with CUDA 12.8
# Multi-stage: base (toolchain) → builder (transcribe CLI) / bundler (full app bundles)
# Only requires NVIDIA driver on host, NOT full CUDA toolkit

# ============================================================================
# Base stage: CUDA toolkit + Rust + system deps + CUDA runtime libs
# Used by: build-dev, and as foundation for builder and bundler stages
# ============================================================================
FROM nvidia/cuda:12.8.0-devel-ubuntu22.04 AS base

# Install build dependencies
RUN apt-get update && apt-get install -y \
    curl \
    git \
    build-essential \
    pkg-config \
    libssl-dev \
    libwebkit2gtk-4.1-dev \
    libgtk-3-dev \
    libayatana-appindicator3-dev \
    librsvg2-dev \
    libasound2-dev \
    patchelf \
    && rm -rf /var/lib/apt/lists/*

# Install Rust
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:$PATH"

# Set up CUDA paths
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=${CUDA_HOME}/bin:${PATH}
ENV LD_LIBRARY_PATH=${CUDA_HOME}/lib64:${LD_LIBRARY_PATH}

# Configure for universal GPU support via PTX (Parallel Thread Execution)
# PTX is NVIDIA's virtual ISA that JIT-compiles to any GPU at runtime
#
# Strategy: Build PTX for a baseline compute capability
# - compute_75 (Turing) covers: RTX 20/30/40/50 series, T4, A100, H100
# - At runtime, CUDA driver JIT-compiles PTX to actual GPU architecture
# - Works on ANY GPU with compute capability >= 7.5
# - First inference is ~10-20% slower (JIT compile time), then cached
#
# This single binary supports:
#   ✓ RTX 20-series (Turing, sm_75)
#   ✓ RTX 30-series (Ampere, sm_86)
#   ✓ RTX 40-series (Ada, sm_89)
#   ✓ RTX 50-series (Blackwell, sm_120)
#   ✓ A100, H100, and newer datacenter GPUs
#
ENV CUDA_COMPUTE_CAP=75

WORKDIR /build

# Prepare bundled CUDA libraries BEFORE building
# This ensures the binary links against the exact libraries we'll bundle
RUN mkdir -p /build/lib && \
    echo "=== Copying CUDA runtime libraries ===" && \
    cp -P ${CUDA_HOME}/lib64/libcudart.so* /build/lib/ && \
    cp -P ${CUDA_HOME}/lib64/libcublas.so* /build/lib/ && \
    cp -P ${CUDA_HOME}/lib64/libcublasLt.so* /build/lib/ && \
    cp -P ${CUDA_HOME}/lib64/libnvrtc.so* /build/lib/ && \
    cp -P ${CUDA_HOME}/lib64/libcufft.so* /build/lib/ 2>/dev/null || true && \
    cp -P ${CUDA_HOME}/lib64/libcurand.so* /build/lib/ 2>/dev/null || true && \
    echo "" && \
    echo "=== Bundled libraries ===" && \
    ls -lh /build/lib/

# Copy project files
COPY Cargo.toml Cargo.lock ./
COPY src ./src
COPY build.rs ./
COPY tauri.conf.json ./
COPY assets ./assets
COPY icons ./icons
COPY capabilities ./capabilities
COPY gen ./gen

# Add our lib directory to the library path during build
ENV LD_LIBRARY_PATH=/build/lib:${LD_LIBRARY_PATH}

# ============================================================================
# Builder stage: builds standalone transcribe CLI with bundled CUDA libs
# Used by: build-cuda-static service
# ============================================================================
FROM base AS builder

RUN cargo build --release --features cuda --bin transcribe

# Create distribution package with RPATH set
RUN mkdir -p /dist/lib && \
    cp /build/target/release/transcribe /dist/ && \
    # Use cp -a to preserve symlinks (reduces size from 4GB to 1.4GB)
    cp -a /build/lib/* /dist/lib/ && \
    # Set RPATH so binary looks for libraries in ./lib relative to binary location
    patchelf --set-rpath '$ORIGIN/lib' /dist/transcribe && \
    echo "" && \
    echo "=== Verifying RPATH ===" && \
    patchelf --print-rpath /dist/transcribe && \
    echo "" && \
    echo "=== Distribution package ===" && \
    ls -lh /dist/ && \
    echo "" && \
    echo "=== CUDA libraries (with symlinks) ===" && \
    ls -lh /dist/lib/ && \
    echo "" && \
    echo "=== Actual library sizes (unique files only) ===" && \
    du -ch /dist/lib/*.so.*.* 2>/dev/null | tail -1 && \
    echo "" && \
    echo "=== All binary dependencies ===" && \
    LD_LIBRARY_PATH=/dist/lib ldd /dist/transcribe && \
    echo "" && \
    echo "=== CUDA/NVIDIA dependencies ===" && \
    (LD_LIBRARY_PATH=/dist/lib ldd /dist/transcribe | grep -E "cuda|nvidia" || echo "No direct CUDA deps - may use driver API only")

# ============================================================================
# Bundler stage: base + Node.js for tauri build (.deb/.rpm/.AppImage)
# Used by: bundle-cuda service
# ============================================================================
FROM base AS bundler

RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y \
    nodejs \
    # RPM bundling
    rpm \
    # AppImage bundling
    libfuse2 \
    file \
    xdg-utils \
    && rm -rf /var/lib/apt/lists/*

# appimagetool for post-processing AppImages (remove bundled libcuda stub)
RUN curl -fsSL -o /usr/local/bin/appimagetool \
    "https://github.com/AppImage/AppImageKit/releases/download/continuous/appimagetool-x86_64.AppImage" && \
    chmod +x /usr/local/bin/appimagetool

# ============================================================================
# Runtime stage: minimal image for testing the standalone CLI
# ============================================================================
FROM ubuntu:22.04 AS runtime

# Only install NVIDIA driver stubs for testing
# Real host will have actual drivers
RUN apt-get update && apt-get install -y \
    libnvidia-compute-545 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/target/release/transcribe /usr/local/bin/transcribe

ENTRYPOINT ["transcribe"]
