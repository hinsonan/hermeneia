# will have schema files for capabilities auto-completion
/gen/schemas

# CUDA distribution package (binary + bundled libraries)
/dist/

# CUDA libraries extracted for local development
/cuda-libs/

# CUDA dev build output (compiled inside Docker)
/target-cuda/

# CUDA bundle staging/output artifacts
/cuda-bundles/
